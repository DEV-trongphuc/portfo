{
  "name": "portfolio_marketing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seal:key": "node scripts/seal-key.mjs",
    "train:rag": "node scripts/train-rag.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:fast": "node --test tests/e2e/runner.test.ts",
    "test:e2e:tier1": "playwright test tests/e2e/specs/tier1-features.spec.ts",
    "test:e2e:tier2": "playwright test tests/e2e/specs/tier2-boundaries.spec.ts",
    "test:e2e:tier3": "playwright test tests/e2e/specs/tier3-combinations.spec.ts",
    "test:e2e:tier4": "playwright test tests/e2e/specs/tier4-scenarios.spec.ts",
    "test:e2e:tier5": "playwright test tests/e2e/specs/tier5-adversarial.spec.ts --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:all": "npm run build && node --test tests/e2e/runner.test.ts && playwright test"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
