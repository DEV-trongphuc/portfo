{
  "functions": {
    "api/chat.ts": {
      "includeFiles": "src/data/ragIndex.json",
      "maxDuration": 30
    },
    "api/contact.ts": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|imgs/|ERP-Product/|fonts/|pdf/|favicon\\.png|favicon-192\\.png|apple-touch-icon\\.png|me\\.webp|robots\\.txt|sitemap\\.xml|llms\\.txt|llms-full\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
